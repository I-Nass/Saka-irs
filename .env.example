# ── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database ────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/saka-irs

# ── Providers (runs fully local with everything else off)
LOCAL_PROVIDER=true
EXTERNAL_CORPUS_PROVIDER=true
WIKIMEDIA_PROVIDER=true
EXTERNAL_REVERSE_PROVIDER=false
SEMANTIC_PROVIDER=false

# ── External provider keys (Category B — Optional)
GOOGLE_VISION_API_KEY=

# ── External provider behavior
EXTERNAL_TIMEOUT_MS=8000

# ── Matching thresholds (defaults pending benchmark calibration — Section 38)
NEAR_DUPLICATE_THRESHOLD=6
VISUAL_MATCH_THRESHOLD=12

# ── Reverse-image providers (external, opt-in)
# trace.moe — keyless, no account, anime/illustration only, ~100 searches/day.
# Enabling it transmits a metadata-stripped copy of the image to api.trace.moe.
TRACEMOE_PROVIDER=false
TRACEMOE_DAILY_LIMIT=100
TRACEMOE_TIMEOUT_MS=7000
# Optional: point at your own self-hosted trace.moe instance.
TRACEMOE_API_URL=

# SerpApi — free tier is ~100 searches/month (no credit card).
# Setting a key is what enables it. Uploads a metadata-stripped JPEG (<=500 KB)
# to serpapi.com for a Google Lens lookup.
SERPAPI_KEY=
SERPAPI_MONTHLY_LIMIT=100
SERPAPI_TIMEOUT_MS=7000

# SerpApi's Yandex engine needs a PUBLICLY reachable image URL, so it only runs
# when this app is exposed over HTTPS. Leave empty to skip Yandex.
PUBLIC_BASE_URL=

# ── Reverse-image pivot panel (browser-side, nothing is uploaded here)
PIVOT_MAX_DIM=1280

# ── Specialized Domain & Geo-OSINT
# Local Geo-OSINT environmental & timezone profiler (100% offline, zero keys)
GEO_OSINT_PROVIDER=true

# Biological & Wildlife Taxonomy (iNaturalist API — free, opt-in)
INATURALIST_PROVIDER=false
INATURALIST_TIMEOUT_MS=7000

# ── External cache (repeat searches cost no quota)
EXTERNAL_CACHE_DAYS=30

# ── Retention & limits
RETENTION_DAYS=7
QUERY_RETENTION_HOURS=24
MAX_FILE_SIZE_MB=15
MAX_PIXELS=50000000
