# ── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database ────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/saka-irs

# ── Providers (runs fully local with everything else off)
LOCAL_PROVIDER=true
EXTERNAL_CORPUS_PROVIDER=true
EXTERNAL_REVERSE_PROVIDER=false
SEMANTIC_PROVIDER=false

# ── External provider keys (Category B — Optional)
GOOGLE_VISION_API_KEY=

# ── External provider behavior
EXTERNAL_TIMEOUT_MS=8000

# ── Matching thresholds (defaults pending benchmark calibration — Section 38)
NEAR_DUPLICATE_THRESHOLD=6
VISUAL_MATCH_THRESHOLD=12

# ── Retention & limits
RETENTION_DAYS=7
QUERY_RETENTION_HOURS=24
MAX_FILE_SIZE_MB=15
MAX_PIXELS=50000000
